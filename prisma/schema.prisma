// Cadence — Goal Setting & Tracking Portal

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// User & Roles
// ============================================================

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(EMPLOYEE)
  department   String?
  title        String?

  managerId String?
  manager   User?   @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[]  @relation("EmployeeManager")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goalSheets    GoalSheet[]
  ownedGoals    Goal[]      @relation("GoalOwner")
  approvedGoals Goal[]      @relation("GoalApprover")
  auditEntries  AuditLog[]
  checkIns      CheckIn[]

  @@index([role])
  @@index([managerId])
}

// ============================================================
// Cycle
// ============================================================

enum CyclePhase {
  GOAL_SETTING
  Q1_CHECKIN
  Q2_CHECKIN
  Q3_CHECKIN
  Q4_FINAL
  CLOSED
}

model Cycle {
  id           String     @id @default(cuid())
  name         String
  startDate    DateTime
  endDate      DateTime
  currentPhase CyclePhase @default(GOAL_SETTING)
  isActive     Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goalSheets GoalSheet[]

  @@index([isActive])
}

// ============================================================
// GoalSheet
// ============================================================

enum SheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

model GoalSheet {
  id            String      @id @default(cuid())
  ownerId       String
  owner         User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cycleId       String
  cycle         Cycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  status        SheetStatus @default(DRAFT)

  submittedAt   DateTime?
  approvedAt    DateTime?
  approverNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goals Goal[]

  @@unique([ownerId, cycleId])
  @@index([status])
}

// ============================================================
// Goal
// ============================================================

enum UoMType {
  NUMERIC_MIN
  NUMERIC_MAX
  PERCENT_MIN
  PERCENT_MAX
  TIMELINE
  ZERO
}

enum GoalStatus {
  NOT_STARTED
  ON_TRACK
  COMPLETED
}

model Goal {
  id           String    @id @default(cuid())
  sheetId      String
  sheet        GoalSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  ownerId      String
  owner        User      @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  approvedById String?
  approvedBy   User?     @relation("GoalApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  thrustArea   String
  title        String
  description  String?
  uomType      UoMType
  uomUnit      String?

  targetValue  Decimal?  @db.Decimal(15, 2)
  targetDate   DateTime?
  weightage    Int

  actualValue  Decimal?  @db.Decimal(15, 2)
  actualDate   DateTime?
  status       GoalStatus @default(NOT_STARTED)
  progressPct  Float?

  isShared     Boolean   @default(false)
  parentGoalId String?
  parentGoal   Goal?     @relation("SharedGoalSync", fields: [parentGoalId], references: [id], onDelete: SetNull)
  childGoals   Goal[]    @relation("SharedGoalSync")

  isLocked     Boolean   @default(false)
  lockedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkIns CheckIn[]

  @@index([sheetId])
  @@index([ownerId])
  @@index([status])
}

// ============================================================
// CheckIn
// ============================================================

enum CheckInPeriod {
  Q1
  Q2
  Q3
  Q4_FINAL
}

model CheckIn {
  id            String        @id @default(cuid())
  goalId        String
  goal          Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  period        CheckInPeriod

  actualValue   Decimal?      @db.Decimal(15, 2)
  actualDate    DateTime?
  status        GoalStatus
  employeeNote  String?

  managerComment String?
  reviewedById   String?
  reviewedBy     User?         @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?

  progressPct   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([goalId, period])
  @@index([period])
}

// ============================================================
// AuditLog
// ============================================================

enum AuditAction {
  GOAL_EDITED
  TARGET_CHANGED
  WEIGHTAGE_CHANGED
  GOAL_UNLOCKED
  SHEET_APPROVED
  SHEET_RETURNED
  CHECKIN_SUBMITTED
  CHECKIN_REVIEWED
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String
  actor      User        @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action     AuditAction
  entityType String
  entityId   String
  diff       Json?
  note       String?

  createdAt DateTime @default(now())

  @@index([entityId])
  @@index([createdAt])
}

// ============================================================
// AiSuggestion
// ============================================================

model AiSuggestion {
  id            String   @id @default(cuid())
  userId        String
  originalText  String
  suggestedText String
  smartScore    Int?
  accepted      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
}
